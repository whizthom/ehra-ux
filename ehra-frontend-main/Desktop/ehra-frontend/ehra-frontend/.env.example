# Copy this file to .env (local dev) or set these as environment variables
# in your Vercel project's "Environment Variables" tab (production build).
#
# IMPORTANT after any host migration (e.g. Render -> Vercel/Railway): this
# var is baked in at BUILD TIME by Vite, not read at runtime. Vercel does
# NOT proxy /api anywhere — that fallback only works with the local Vite
# dev server. If this is unset (or stale) in Vercel's dashboard, every
# API call in production silently resolves to a same-origin
# https://ehral.com/api/... request, which Vercel's static hosting has no
# route for — those calls fail (404, not a network error), and any screen
# that treats "request failed" the same as "server said no" (e.g. the
# invite-link landing page before this fix) will misreport a perfectly
# valid link/resource as unavailable. Always redeploy after changing this.

# Base URL the app calls for API requests.
# - Local dev: leave unset — requests to /api are proxied to
#   http://localhost:8080 by vite.config.js.
# - Vercel / production: set to your deployed Railway backend's URL, e.g.
#   VITE_API_BASE_URL=https://ehra-backend-production.up.railway.app/api
#   (or your custom API domain, if you've mapped one).
VITE_API_BASE_URL=

# No client-side config needed for phone OTP anymore — Termii's API key
# lives only on the backend (Railway env var TERMII_API_KEY), never in
# this frontend bundle. See Ehra/src/main/resources/application.properties
# on the backend for the Termii-related env vars.